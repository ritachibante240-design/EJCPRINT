generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String    @id @default(cuid())
  name                String
  email               String?   @unique
  phone               String?   @unique
  passwordHash        String?
  sessionVersion      Int       @default(0)
  resetTokenHash      String?
  resetTokenExpiresAt DateTime?
  resetTokenUsedAt    DateTime?
  role                UserRole  @default(CLIENT)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  orders              Order[]
}

model Order {
  id                String      @id @default(cuid())
  number            String      @unique
  externalReference String?     @unique
  clientId          String?
  customerName      String
  customerPhone     String
  service           String
  unitPriceCents    Int
  pageCount         Int
  copyCount         Int
  doubleSided       Boolean     @default(false)
  sheetsRequired    Int
  bindingType       String      @default("SEM_ENCADERNACAO")
  bindingPriceCents Int         @default(0)
  totalCents        Int
  status            OrderStatus @default(RECEIVED)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  documents         Document[]
  client            User?       @relation(fields: [clientId], references: [id])
  payments          Payment[]
  stockMovements    StockMovement[]

  @@index([clientId], map: "Order_clientId_fkey")
}

model Payment {
  id                String        @id @default(cuid())
  externalReference String?       @unique
  orderId           String
  amountCents       Int
  method            String
  type              String
  status            PaymentStatus @default(PENDING)
  reference         String?
  proofStorageKey   String?       @unique
  proofSha256       String?       @unique
  proofOriginalName String?
  proofMimeType     String?
  proofSizeBytes    Int?
  rejectionReason   String?
  createdAt         DateTime      @default(now())
  confirmedAt       DateTime?
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId], map: "Payment_orderId_fkey")
}

model Document {
  id           String   @id @default(cuid())
  orderId      String
  originalName String
  storageKey   String   @unique
  mimeType     String?
  sizeBytes    Int?
  createdAt    DateTime @default(now())
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId], map: "Document_orderId_fkey")
}

model StockItem {
  id              String          @id @default(cuid())
  name            String
  normalizedName  String          @unique
  category        String
  unit            String
  quantity        Float           @default(0)
  minimumQuantity Float           @default(0)
  averageUnitCost Float           @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  movements       StockMovement[]
}

model StockMovement {
  id                String      @id @default(cuid())
  externalReference String?     @unique
  stockItemId       String
  orderId           String?
  type              String
  quantity          Float
  amountCents       Int?
  unitCost          Float?
  reason            String?
  createdAt         DateTime    @default(now())
  expense           Expense?
  stockItem         StockItem   @relation(fields: [stockItemId], references: [id], onDelete: Restrict)
  order             Order?      @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([stockItemId, createdAt])
  @@index([orderId])
}

model Expense {
  id                String         @id @default(cuid())
  externalReference String?        @unique
  description       String
  category          String
  type              String
  amountCents       Int
  stockMovementId  String?        @unique
  createdAt         DateTime       @default(now())
  stockMovement    StockMovement? @relation(fields: [stockMovementId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([type, createdAt])
}

enum UserRole {
  CLIENT
  ADMIN
}

enum OrderStatus {
  RECEIVED
  PREPARING
  PRINTING
  READY_FOR_PICKUP
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  REJECTED
}
